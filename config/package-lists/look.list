# GUI polish layer — what makes it look premium rather than "stock Linux".
# Applied alongside the desktop in chroot/install-desktop.sh.

# ---- Icon & cursor themes ----------------------------------------------------
papirus-icon-theme        # crisp, modern, widely loved icon set
breeze-cursor-theme

# ---- Theming engines ---------------------------------------------------------
qt5-style-kvantum          # Kvantum engine (noble ships Plasma 5.27 / Qt5)
qt5-style-kvantum-themes
plasma-workspace-wallpapers

# ---- Fonts (UI + mono + reading) ---------------------------------------------
fonts-inter                # premium UI font — Dyuti's default interface typeface
fonts-cantarell            # guaranteed fallback if Inter is unavailable
fonts-firacode             # nice monospace for terminal/code
fonts-roboto               # clean UI fallback
fonts-noto-extra           # broad script coverage

# ---- Boot splash (branded later via the branding package) --------------------
plymouth
plymouth-themes
plymouth-label

# ---- Display / smoothness helpers --------------------------------------------
plasma-thunderbolt
xdg-desktop-portal-kde      # consistent file dialogs / sandboxed app integration
