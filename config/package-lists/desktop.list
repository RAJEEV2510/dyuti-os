# KDE Plasma desktop — the rendering engine we reshape into our own look.
# Kept lean for the alpha (plasma-desktop, not the full kde-full metapackage).

plasma-desktop
plasma-workspace
plasma-nm
plasma-pa
sddm
kde-config-sddm           # SDDM settings module (package renamed from sddm-kcm)
systemsettings
dolphin
konsole
kwin-x11
kwin-wayland
plasma-systemmonitor
kscreen
breeze
breeze-gtk-theme          # GTK theme matching Breeze (package is breeze-gtk-theme)
powerdevil
power-profiles-daemon     # power modes (Performance / Balanced / Power Saver) in the applet
upower                    # battery + AC status powerdevil needs (only a Recommends — add it)
bluedevil
plasma-discover
plasma-discover-backend-flatpak   # Flatpak apps in the store (Zorin-style curated apps)
plasma-discover-backend-fwupd     # firmware / BIOS updates from the store
xserver-xorg

# ---- Connectivity & "it just works" polish (Zorin parity) --------------------
kdeconnect                # phone integration — richer, native answer to Zorin Connect
plasma-firewall           # simple firewall GUI (Zorin ships one by default)
plasma-browser-integration # media controls + downloads from the browser
kdialog                   # dialogs used by the Dyuti Layouts / Drivers tools
kde-cli-tools             # kreadconfig5/kioclient5/kstart5 — Dyuti tools rely on these
qdbus-qt5                 # ships /usr/bin/qdbus — REQUIRED by dyuti-panel-setup (kde-cli-tools does NOT provide it)
milou                     # ships the org.kde.milou QML module — REQUIRED by org.dyuti.search inline results
