#!/bin/sh
# Post-install for the Dyuti branding package.
set -e

case "$1" in
  configure)
    # Point /usr/lib/os-release (diverted away in preinst) at our branded copy.
    if [ -f /usr/lib/os-release.dyuti ]; then
      ln -sf os-release.dyuti /usr/lib/os-release
    fi

    # Refresh font cache so any shipped fonts register.
    if command -v fc-cache >/dev/null 2>&1; then
      fc-cache -f >/dev/null 2>&1 || true
    fi
    # Branded console login banner.
    if [ -f /usr/share/dyuti/issue ]; then
      cp /usr/share/dyuti/issue /etc/issue || true
    fi

    # Register + select the Dyuti Plymouth boot splash, then refresh initramfs.
    DYUTI_PLY=/usr/share/plymouth/themes/dyuti/dyuti.plymouth
    if [ -f "$DYUTI_PLY" ] && command -v update-alternatives >/dev/null 2>&1; then
      update-alternatives --install \
        /usr/share/plymouth/themes/default.plymouth default.plymouth "$DYUTI_PLY" 200 || true
      update-alternatives --set default.plymouth "$DYUTI_PLY" || true
      if command -v update-initramfs >/dev/null 2>&1; then
        update-initramfs -u || true
      fi
    fi

    # Apply the Dyuti global look-and-feel as the system default where possible.
    if command -v plymouth-set-default-theme >/dev/null 2>&1; then
      plymouth-set-default-theme dyuti || true
    fi

    # Icon theme is Papirus (complete + colourful, works light AND dark — fixes
    # the faded/invisible icons the Tela-based set had). Recolour Papirus folders
    # to the Dyuti saffron/orange so the brand identity carries through. Prefer the
    # papirus-folders tool; otherwise re-point each base folder*.svg at its
    # -orange sibling (exactly what that tool does). No-ops if a theme is absent.
    for THEME in Papirus-Light Papirus-Dark Papirus; do
      DIR=/usr/share/icons/$THEME
      [ -d "$DIR" ] || continue
      if command -v papirus-folders >/dev/null 2>&1; then
        papirus-folders -C orange -t "$THEME" >/dev/null 2>&1 || true
      else
        # Recolour the regular folders (folder-orange*) AND the special place
        # icons whose colour sits mid-name (user-orange-desktop, user-orange-home,
        # …) so Desktop/Home match the orange folders instead of staying blue.
        find "$DIR" \( -name 'folder-orange*.svg' -o -name 'user-orange-*.svg' \) 2>/dev/null \
          | sed 's#/[^/]*$##' | sort -u | while read -r d; do
            ( cd "$d" || exit 0
              for src in folder-orange*.svg user-orange-*.svg; do
                [ -e "$src" ] || continue
                dst=$(printf '%s' "$src" | sed 's/-orange//')
                ln -sf "$src" "$dst"
              done )
          done
      fi
      command -v gtk-update-icon-cache >/dev/null 2>&1 \
        && gtk-update-icon-cache -q "$DIR" 2>/dev/null || true
    done

    # Point Calamares at our branding without overwriting its settings.conf
    # (which another package owns). Just rewrite the `branding:` line.
    CALA=/etc/calamares/settings.conf
    if [ -f "$CALA" ]; then
      if grep -qE '^branding:' "$CALA"; then
        sed -i 's/^branding:.*/branding: dyuti/' "$CALA" || true
      else
        echo "branding: dyuti" >> "$CALA"
      fi
    fi

    # Rebrand the Debian-provided installer launcher. On the live session
    # `add-calamares-desktop-icon` copies this .desktop to ~/Desktop, where it
    # showed "Install Debian". The file is owned by calamares-settings-debian,
    # so patch it in place (handles the default + any localized Name= lines).
    CALA_LAUNCHER=/usr/share/applications/calamares-install-debian.desktop
    if [ -f "$CALA_LAUNCHER" ]; then
      sed -i -E \
        -e 's/^Name(\[[^]]*\])?=.*/Name\1=Install Dyuti OS/' \
        -e 's/^GenericName(\[[^]]*\])?=.*/GenericName\1=System Installer/' \
        -e 's/^Comment(\[[^]]*\])?=.*/Comment\1=Install Dyuti OS to this computer/' \
        "$CALA_LAUNCHER" || true
    fi
    ;;
esac

exit 0
