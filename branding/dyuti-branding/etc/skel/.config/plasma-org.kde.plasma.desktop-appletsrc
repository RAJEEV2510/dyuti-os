# Default desktop + panel layout for new users — Windows 11-style footer.
# Floating bottom panel: weather on the left, Start + task icons centred (two
# expanding panelspacers do the centring), system tray + clock on the right.
# immutability=1 = Mutable, so users can still customise.

[Containments][1]
activityId=
formfactor=0
immutability=1
lastScreen=0
location=0
plugin=org.kde.plasma.folder
wallpaperplugin=org.kde.image

[Containments][1][Wallpaper][org.kde.image][General]
Image=file:///usr/share/backgrounds/dyuti/dyuti-mountain.png
SlidePaths=/usr/share/backgrounds/dyuti

[Containments][2]
activityId=
formfactor=2
immutability=1
lastScreen=0
location=4
plugin=org.kde.panel

[Containments][2][General]
# weather ; spacer ; start ; tasks ; spacer ; tray ; clock ; show-desktop
AppletOrder=9;5;3;4;10;6;7;8
# Floating, detached panel — the modern Plasma 5.27 premium look.
floating=1

[Containments][2][Applets][3]
immutability=1
plugin=org.kde.plasma.kickoff

[Containments][2][Applets][3][Configuration][General]
icon=dyuti-logo

[Containments][2][Applets][4]
immutability=1
plugin=org.kde.plasma.icontasks

[Containments][2][Applets][5]
immutability=1
plugin=org.kde.plasma.panelspacer

[Containments][2][Applets][5][Configuration][General]
expanding=true

[Containments][2][Applets][6]
immutability=1
plugin=org.kde.plasma.systemtray

[Containments][2][Applets][7]
immutability=1
plugin=org.kde.plasma.digitalclock

[Containments][2][Applets][7][Configuration][Appearance]
showDate=true

[Containments][2][Applets][8]
immutability=1
plugin=org.kde.plasma.showdesktop

[Containments][2][Applets][9]
immutability=1
plugin=org.kde.plasma.weather

[Containments][2][Applets][10]
immutability=1
plugin=org.kde.plasma.panelspacer

[Containments][2][Applets][10][Configuration][General]
expanding=true
