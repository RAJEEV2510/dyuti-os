# KWin compositor defaults — the smoothness layer.
# Blur + subtle animations + adaptive sync for a polished, fluid feel.

[Compositing]
Enabled=true
# Faster window animations (was 3) — pairs with AnimationDurationFactor=0.5 for a
# lighter, snappier desktop.
AnimationSpeed=2
Backend=OpenGL
GLCore=true
WindowsBlockCompositing=true

[Plugins]
blurEnabled=true
contrastEnabled=true
slideEnabled=true
fadeEnabled=true
# No gimmicks (wobbly windows etc.) — keep it clean and fast.
wobblywindowsEnabled=false

[Effect-blur]
BlurStrength=8
NoiseStrength=2

[Windows]
# Snap/tiling helpers users expect.
ElectricBorderMaximize=true
ElectricBorderTiling=true

# Ship ONE virtual desktop by default — clean, like Windows. No pager on the
# panel; users add more desktops on demand via the Task View "+" button.
[Desktops]
Number=1
Rows=1
Id_1=dyuti-desktop-1
Name_1=Desktop 1
