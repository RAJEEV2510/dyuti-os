#
# Dyuti Light — Kvantum theme config (light variant).
# Single source of truth: docs/design-tokens.md (light theme). Element names
# below match ids in DyutiLight.svg (generated by tools/gen-kvantum-svg.py) and
# are identical to the dark Dyuti theme; only the palette differs. Direction:
# crisp neutral grey-white, restrained saffron accent, soft radius, depth via
# surface + shadow.
#

[%General%]
author=Dyuti Project
comment=Premium light, restrained saffron accent. Generated from design tokens.
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=true
attach_active_tab=false
mirror_doc_tabs=true
group_toolbar_buttons=false
toolbar_item_spacing=2
toolbar_interior_spacing=3
spread_progressbar=true
composite=true
menu_shadow_depth=14
tooltip_shadow_depth=10
splitter_width=2
scroll_width=12
scroll_arrows=false
scroll_min_extent=64
slider_width=4
slider_handle_width=18
slider_handle_length=18
center_toolbar_handle=true
check_size=16
textless_progressbar=false
progressbar_thickness=6
menubar_mouse_tracking=true
toolbutton_style=0
double_click=false
translucent_windows=false
blurring=false
popup_blurring=true
vertical_spin_indicators=false
spin_button_width=18
fill_rubberband=false
merge_menubar_with_toolbar=true
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=16
combo_as_lineedit=false
animate_states=true
combo_menu=true
hide_combo_checkboxes=true
combo_focus_rect=false
groupbox_top_label=true
inline_spin_indicators=true
joined_inactive_tabs=false
layout_spacing=6
layout_margin=8
scrollbar_in_view=false
transient_scrollbar=true
transient_groove=true
submenu_overlap=0
tooltip_delay=-1
reduce_menu_opacity=0
reduce_window_opacity=0
respect_DE=true
shadowless_popup=false
no_window_pattern=true

[GeneralColors]
window.color=#eef1f5
inactive.window.color=#eef1f5
base.color=#e4e8ed
alt.base.color=#f7f9fb
button.color=#ffffff
light.color=#ffffff
mid.light.color=#f7f9fb
dark.color=#c2cad4
mid.color=#dce1e8
highlight.color=#ff9d4d
inactive.highlight.color=#ffe6cf
text.color=#14171c
window.text.color=#14171c
button.text.color=#14171c
disabled.text.color=#9aa3b0
tooltip.text.color=#14171c
highlight.text.color=#1a1206
link.color=#f08a35
link.visited.color=#c4631a
progress.indicator.text.color=#1a1206

[Hacks]
transparent_dolphin_view=true
blur_translucent=true
transparent_ktitle_label=true
transparent_menutitle=true
respect_darkness=true
kcapacitybar_as_progressbar=true
force_size_grip=true
iconless_pushbutton=false
iconless_menu=false
disabled_icon_opacity=45
normal_default_pushbutton=true
single_top_toolbar=true
tint_on_mouseover=0
transparent_pcmanfm_view=true
transparent_pcmanfm_sidebar=true
blur_only_active_window=false
opaque_colors=false

#
# ---- Buttons & inputs ---------------------------------------------------
#
[PanelButtonCommand]
frame=true
frame.element=button
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
interior=true
interior.element=button
indicator.element=arrow
indicator.size=12
text.shadow=false
text.margin=true
text.margin.top=3
text.margin.bottom=3
text.margin.left=10
text.margin.right=10
text.normal.color=#14171c
text.focus.color=#14171c
text.press.color=#14171c
text.toggle.color=#14171c

[PanelButtonTool]
inherits=PanelButtonCommand
frame=true
frame.element=tbutton
interior.element=tbutton
indicator.element=arrow
text.normal.color=#14171c
text.focus.color=#14171c

[DropDownButton]
inherits=PanelButtonTool
frame=false
interior=false

[IndicatorArrow]
element=arrow
size=12

[ComboBox]
frame=true
frame.element=combo
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
interior=true
interior.element=combo
indicator.element=arrow
indicator.size=12
text.margin.left=10
text.margin.right=8
text.normal.color=#14171c
text.focus.color=#14171c

[LineEdit]
frame=true
frame.element=lineedit
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
interior=true
interior.element=lineedit
text.margin.left=8
text.margin.right=8

[IndicatorSpinBox]
inherits=LineEdit
frame=true
frame.element=combo
interior.element=combo
indicator.element=arrow
indicator.size=12

[CheckBox]
frame=false
interior=false
indicator.element=checkbox
indicator.size=16
text.normal.color=#14171c

[RadioButton]
frame=false
interior=false
indicator.element=radio
indicator.size=16
text.normal.color=#14171c

[Focus]
frame=true
frame.element=focus
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
interior=false

#
# ---- Tabs ---------------------------------------------------------------
#
[Tab]
frame=true
frame.element=tab
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
interior=true
interior.element=tab
text.margin.top=3
text.margin.bottom=3
text.margin.left=12
text.margin.right=12
text.normal.color=#565e6b
text.focus.color=#14171c
text.press.color=#14171c
text.toggle.color=#14171c

[TabFrame]
frame=true
frame.element=tabframe
frame.top=10
frame.bottom=10
frame.left=10
frame.right=10
interior=true
interior.element=tabframe

#
# ---- Containers ---------------------------------------------------------
#
[GenericFrame]
frame=true
frame.element=genframe
frame.top=10
frame.bottom=10
frame.left=10
frame.right=10
interior=false

[GroupBox]
frame=true
frame.element=group
frame.top=10
frame.bottom=10
frame.left=10
frame.right=10
interior=true
interior.element=group
text.normal.color=#14171c

[Toolbar]
frame=true
frame.element=toolbar
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
interior=true
interior.element=toolbar

[MenuBar]
frame=false
interior=false

[MenuBarItem]
frame=true
frame.element=menuitem
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
interior=true
interior.element=menuitem
text.margin.left=10
text.margin.right=10
text.normal.color=#14171c
text.focus.color=#14171c

[HeaderSection]
frame=true
frame.element=tbutton
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
interior=true
interior.element=tbutton
text.normal.color=#565e6b

[StatusBar]
frame=false
interior=false

[ItemView]
frame=false
interior=false
text.normal.color=#14171c

#
# ---- Popups -------------------------------------------------------------
#
[Menu]
frame=true
frame.element=menu
frame.top=10
frame.bottom=10
frame.left=10
frame.right=10
interior=true
interior.element=menu

[MenuItem]
frame=true
frame.element=menuitem
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
interior=true
interior.element=menuitem
indicator.element=arrow
indicator.size=12
text.margin.top=3
text.margin.bottom=3
text.margin.left=12
text.margin.right=12
text.normal.color=#14171c
text.focus.color=#14171c

[Tooltip]
frame=true
frame.element=tooltip
frame.top=8
frame.bottom=8
frame.left=8
frame.right=8
interior=true
interior.element=tooltip
text.margin.top=4
text.margin.bottom=4
text.margin.left=8
text.margin.right=8

#
# ---- Progress / sliders / scrollbar ------------------------------------
#
[Progressbar]
frame=true
frame.element=progress
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
interior=true
interior.element=progress
text.normal.color=#14171c

[ProgressbarContents]
frame=true
frame.element=progressindicator
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
interior=true
interior.element=progressindicator

[Slider]
frame=true
frame.element=slidergroove
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
interior=true
interior.element=slidergroove

[SliderCursor]
frame=true
frame.element=slidercursor
frame.top=9
frame.bottom=9
frame.left=9
frame.right=9
interior=true
interior.element=slidercursor

[Scrollbar]
frame=false
interior=false
indicator.element=arrow
indicator.size=12

[ScrollbarSlider]
frame=true
frame.element=scrollslider
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
interior=true
interior.element=scrollslider
