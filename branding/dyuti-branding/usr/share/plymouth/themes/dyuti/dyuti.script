// Dyuti OS Plymouth boot splash (script module).
// Deep-indigo background + a saffron ring of dots that rotates while booting.
// If a logo.png is dropped into this folder it is shown centred (optional).

// ---- background (radiance indigo) -------------------------------------------
Window.SetBackgroundTopColor(0.078, 0.090, 0.165);     // #14172a
Window.SetBackgroundBottomColor(0.050, 0.060, 0.110);  // darker indigo

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
cx = screen_w / 2;
cy = screen_h / 2;

// ---- optional logo ----------------------------------------------------------
logo.image = Image("logo.png");          // null if file absent
logo.sprite = Sprite();
if (logo.image) {
    logo.sprite.SetImage(logo.image);
    logo.sprite.SetX(cx - logo.image.GetWidth() / 2);
    logo.sprite.SetY(cy - logo.image.GetHeight() / 2 - 40);
    logo.sprite.SetOpacity(1);
}

// ---- spinner: a ring of dots ------------------------------------------------
dot_count = 12;
radius = 42;
for (i = 0; i < dot_count; i++) {
    dots[i].sprite = Sprite();
    dots[i].sprite.SetZ(10);
}

progress = 0;

fun refresh() {
    progress++;
    angle_base = progress / 6;
    for (i = 0; i < dot_count; i++) {
        a = angle_base + (i * (2 * 3.14159265 / dot_count));
        x = cx + Math.Cos(a) * radius;
        y = cy + 90 + Math.Sin(a) * radius;
        // trailing fade so the ring looks like it spins
        op = (i + 1) / dot_count;
        // a small saffron square stands in for a dot
        if (!dots[i].image) {
            dots[i].image = Image.Text(".", 1, 0.62, 0.30, 1, "Sans 22");
        }
        dots[i].sprite.SetImage(dots[i].image);
        dots[i].sprite.SetX(x);
        dots[i].sprite.SetY(y);
        dots[i].sprite.SetOpacity(op);
    }
}
Plymouth.SetRefreshFunction(refresh);

// ---- password prompt (for encrypted-disk boots) -----------------------------
fun display_password_callback(prompt, bullets) {
    // keep it simple: show the prompt text near the spinner
    p.image = Image.Text(prompt, 0.9, 0.9, 0.95, 1, "Sans 12");
    p.sprite = Sprite(p.image);
    p.sprite.SetX(cx - p.image.GetWidth() / 2);
    p.sprite.SetY(cy + 150);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

// ---- boot message -----------------------------------------------------------
fun message_callback(text) {
    msg.image = Image.Text(text, 0.7, 0.72, 0.8, 1, "Sans 10");
    msg.sprite = Sprite(msg.image);
    msg.sprite.SetX(cx - msg.image.GetWidth() / 2);
    msg.sprite.SetY(screen_h - 60);
}
Plymouth.SetMessageFunction(message_callback);
