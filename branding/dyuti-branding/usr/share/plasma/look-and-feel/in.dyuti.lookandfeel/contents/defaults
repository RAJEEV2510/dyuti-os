; Dyuti Global Theme defaults — applied when a user selects (or ships with) the
; Dyuti look-and-feel. These set the whole desktop's identity in one place.

[kdeglobals][KDE]
LookAndFeelPackage=in.dyuti.lookandfeel
widgetStyle=Breeze

[kdeglobals][General]
ColorScheme=DyutiLight
AccentColor=255,157,77

[kdeglobals][Icons]
Theme=Papirus

[plasmarc][Theme]
name=default

[kwinrc][org.kde.kdecoration2]
library=org.kde.breeze
theme=Breeze

[Wallpaper]
defaultWallpaperTheme=dyuti
Image=/usr/share/backgrounds/dyuti/dyuti-mountain.png

; Lock screen uses the same mountain default so unlock matches the desktop.
[kscreenlockerrc][Greeter][Wallpaper][org.kde.image][General]
Image=/usr/share/backgrounds/dyuti/dyuti-mountain.png

[ksplashrc][KSplash]
Theme=in.dyuti.lookandfeel
Engine=KSplashQML
