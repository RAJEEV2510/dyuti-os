#!/bin/sh
# Runs once per user (first login). Force-applies the FULL Dyuti light theme
# through the *running* Plasma shell.
#
# Why this exists: Plasma regenerates configs on first run and does NOT reliably
# honour hand-seeded /etc/skel files — the shipped color scheme, Kvantum style,
# icon theme and wallpaper get dropped and the desktop falls back to stock dark.
# Talking to the live shell over D-Bus (plasma-apply-*) survives that
# regeneration, so we re-assert the whole light theme here on first login.
MARK="${XDG_CONFIG_HOME:-$HOME/.config}/dyuti/.theme-applied"
[ -e "$MARK" ] && exit 0

WALL=/usr/share/backgrounds/dyuti/dyuti-mountain.png

# Wait until plasmashell is up enough to accept live theme commands. It registers
# its D-Bus interface a moment after login; plasma-apply-wallpaperimage exits
# non-zero while the shell is unreachable, so we use it as the readiness probe.
ready=
i=0
while [ "$i" -lt 30 ]; do
  if plasma-apply-wallpaperimage "$WALL" >/dev/null 2>&1; then
    ready=1
    break
  fi
  sleep 1
  i=$((i + 1))
done

# Once the shell is reachable, apply the complete light theme (color scheme,
# Kvantum widget style, icons, GTK, wallpaper, lock screen) via the switcher.
# Only mark done once it actually ran against a live shell — otherwise retry on
# the next login rather than leaving the user on a half-applied/dark desktop.
if [ -n "$ready" ]; then
  dyuti-theme light >/dev/null 2>&1 || true
  mkdir -p "$(dirname "$MARK")"
  touch "$MARK"
fi
