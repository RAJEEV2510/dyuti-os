#!/bin/sh
# dyuti-theme [dark|light|toggle] — switch the Dyuti desktop between its dark and
# light variants in one shot: Plasma color scheme (Breeze widget style follows
# it), icon set, GTK (3 + 4) app colors, and the desktop + lock-screen wallpaper.
#
# Run as the logged-in user. The Plasma color scheme and wallpaper apply live
# over D-Bus; GTK colors are picked up by apps as they (re)start.
set -eu

CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
SHARE=/usr/share/dyuti-theme
WALL=/usr/share/backgrounds/dyuti

current_mode() {
  s=$(kreadconfig5 --file kdeglobals --group General --key ColorScheme 2>/dev/null || true)
  [ "$s" = "DyutiLight" ] && echo light || echo dark
}

mode="${1:-toggle}"
if [ "$mode" = "toggle" ]; then
  [ "$(current_mode)" = "light" ] && mode=dark || mode=light
fi

case "$mode" in
  dark)
    scheme=Dyuti;      icons=Dyuti-dark; prefer_dark=true
    gtk_theme=Breeze-Dark
    wall="$WALL/dyuti-dark.png"; lock="$WALL/dyuti-dark.png"
    g3="$SHARE/gtk3-dark.css";  g4="$SHARE/gtk4-dark.css" ;;
  light)
    scheme=DyutiLight; icons=Dyuti;    prefer_dark=false
    gtk_theme=Breeze
    wall="$WALL/dyuti-mountain.png"; lock="$WALL/dyuti-mountain.png"
    g3="$SHARE/gtk3-light.css"; g4="$SHARE/gtk4-light.css" ;;
  *)
    echo "usage: dyuti-theme [dark|light|toggle]" >&2; exit 2 ;;
esac

# --- Plasma color scheme + icon theme ---------------------------------------
# Always write the keys to disk (deterministic default, even headless / before
# the shell is up), THEN ask the live shell to reload them for instant effect.
kwriteconfig5 --file kdeglobals --group General --key ColorScheme "$scheme"
# Breeze widget style follows the color scheme live — windows + menus stay in
# sync, no shell restart needed (the custom Kvantum theme drew menus dark).
kwriteconfig5 --file kdeglobals --group KDE     --key widgetStyle Breeze
kwriteconfig5 --file kdeglobals --group Icons   --key Theme "$icons"
plasma-apply-colorscheme "$scheme" >/dev/null 2>&1 || true

# --- GTK 3 + 4 app colors ----------------------------------------------------
[ -f "$g3" ] && { mkdir -p "$CFG/gtk-3.0"; cp -f "$g3" "$CFG/gtk-3.0/gtk.css"; }
[ -f "$g4" ] && { mkdir -p "$CFG/gtk-4.0"; cp -f "$g4" "$CFG/gtk-4.0/gtk.css"; }
# Theme/icon names + dark preference for GTK + libadwaita apps that honour them.
for ini in "$CFG/gtk-3.0/settings.ini" "$CFG/gtk-4.0/settings.ini"; do
  mkdir -p "$(dirname "$ini")"
  kwriteconfig5 --file "$ini" --group Settings --key gtk-theme-name "$gtk_theme"
  kwriteconfig5 --file "$ini" --group Settings --key gtk-icon-theme-name "$icons"
  kwriteconfig5 --file "$ini" --group Settings \
    --key gtk-application-prefer-dark-theme "$prefer_dark"
done

# --- Wallpaper (live shell) + lock screen ------------------------------------
# Set the desktop wallpaper on EVERY containment by talking to the running
# plasmashell. This evaluateScript path is far more reliable than
# plasma-apply-wallpaperimage, which silently no-ops on some Plasma 5.27
# containment setups (notably the casper live session) — that was why the
# desktop kept falling back to the stock blue wallpaper.
if command -v qdbus >/dev/null 2>&1; then
  qdbus org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
    var ds = desktops();
    for (var i = 0; i < ds.length; ++i) {
      ds[i].wallpaperPlugin = 'org.kde.image';
      ds[i].currentConfigGroup = ['Wallpaper', 'org.kde.image', 'General'];
      ds[i].writeConfig('Image', 'file://$wall');
    }" >/dev/null 2>&1 || true
fi
# Belt-and-suspenders fallback (also seeds the on-disk config for next login).
plasma-apply-wallpaperimage "$wall" >/dev/null 2>&1 || true
kwriteconfig5 --file kscreenlockerrc \
  --group Greeter --group Wallpaper --group org.kde.image --group General \
  --key Image "$lock" || true

echo "Dyuti theme set to: $mode"
echo "Color scheme + wallpaper applied live. Restart open apps (or log out/in)"
echo "for GTK app colours to fully take effect."

# Friendly desktop toast when run from the menu launcher.
if command -v notify-send >/dev/null 2>&1; then
  notify-send -a "Dyuti Theme" -i preferences-desktop-theme-global \
    "Dyuti theme: ${mode}" \
    "Color scheme and wallpaper applied. Restart apps to finish GTK styling." \
    >/dev/null 2>&1 || true
fi
